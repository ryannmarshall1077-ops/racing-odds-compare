{
  "manifest_version": 3,
  "name": "Racing Odds Compare",
  "version": "0.1.0",
  "description": "Compares horse racing odds between Betfair Exchange and a bookmaker.",
  "action": {
    "default_title": "Racing Odds Compare"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.sportsbet.com.au/horse-racing/australia-nz/*/race-*",
        "https://*.sportsbet.com.au/harness-racing/australia-nz/*/race-*",
        "https://*.sportsbet.com.au/greyhound-racing/australia-nz/*/race-*"
      ],
      "js": ["js/contentScripts/sportsbetWatcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.betfair.com.au/exchange/plus/horse-racing/market/*"],
      "js": ["js/contentScripts/betfairWatcher.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://identitysso.betfair.com/*",
    "https://api.betfair.com/*",
    "https://*.sportsbet.com.au/*"
  ]
}
