{
  "manifest_version": 3,
  "name": "Racing Odds Compare",
  "version": "0.1.0",
  "description": "Compares horse racing odds between Betfair Exchange and a bookmaker.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Racing Odds Compare"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": [
    "https://identitysso.betfair.com/*",
    "https://api.betfair.com/*"
  ]
}
