    },
    {
      "matches": ["https://www.tabtouch.com.au/racing/*"],
      "js": ["js/contentScripts/tabtouchWatcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.unibet.com.au/racing*", "https://unibet.com.au/racing*"],
      "js": ["js/contentScripts/unibetWatcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.palmerbet.com/racing/*"],
      "js": ["js/contentScripts/palmerbetWatcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://picklebet.com/en-au/racing/betting/today/*"],
      "js": ["js/contentScripts/picklebetMeetings.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://picklebet.com/en-au/racing/betting/meeting/*"],
      "js": ["js/contentScripts/picklebetMeetings.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://picklebet.com/en-au/racing/betting/race/*"],
