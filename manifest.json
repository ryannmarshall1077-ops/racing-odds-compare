{
  "manifest_version": 3,
  "name": "Racing Odds Compare",
  "version": "0.1.0",
  "key": "",
  "description": "Compares horse and greyhound racing odds between Betfair Exchange and a bookmaker.",
  "action": {
    "default_title": "Racing Odds Compare",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.sportsbet.com.au/horse-racing/australia-nz/*/race-*",
        "https://*.sportsbet.com.au/harness-racing/australia-nz/*/race-*",
        "https://*.sportsbet.com.au/greyhound-racing/australia-nz/*/race-*"
      ],
      "js": ["js/contentScripts/sportsbetWatcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.betfair.com.au/exchange/plus/horse-racing/market/*",
        "https://www.betfair.com.au/exchange/plus/greyhound-racing/market/*"
      ],
      "js": ["js/contentScripts/betfairWatcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tab.com.au/racing/meetings/*"],
      "js": ["js/contentScripts/tabMeetings.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tab.com.au/racing/*"],
      "js": ["js/contentScripts/tabWatcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.ladbrokes.com.au/racing/*"],
      "js": ["js/contentScripts/ladbrokesWatcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.neds.com.au/racing/*"],
      "js": ["js/contentScripts/nedsWatcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://pointsbet.com.au/racing/*/*/*/race/*"],
      "js": ["js/contentScripts/pointsbetWatcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.betr.com.au/racing/*"],
      "js": ["js/contentScripts/betrWatcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tabtouch.com.au/racing/all"],
      "js": ["js/contentScripts/tabtouchMeetings.js"],
