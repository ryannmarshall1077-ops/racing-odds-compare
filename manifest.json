        "https://betjet.com.au/racing/*",
        "https://www.betjet.com.au/racing/*",
        "https://mightybet.com.au/racing/*",
        "https://www.mightybet.com.au/racing/*",
        "https://betexpress.com.au/racing/*",
        "https://www.betexpress.com.au/racing/*",
        "https://yesbet.com.au/racing/*",
        "https://www.yesbet.com.au/racing/*"
      ],
      "js": ["js/contentScripts/amusedWatcher.js"],
      "run_at": "document_idle"
    }
  ],
